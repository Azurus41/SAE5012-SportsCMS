# Copier en .env (non versionné) et changer les mots de passe.
MYSQL_ROOT_PASSWORD=change-moi-root
MYSQL_DATABASE=touchline
MYSQL_USER=touchline
MYSQL_PASSWORD=change-moi

WEB_PORT=8080
PMA_PORT=8081

# Vide : le front tourne avec l'API simulée (démonstration). Avec le back : http://localhost:8080
VITE_API_URL=

# Clés des API open data, lues uniquement par le serveur (proxy /api/proxy/{id}).
FOOTBALL_DATA_KEY=

# Pour publier les images sur un hub : docker compose build && docker compose push
HUB_NAMESPACE=touchline
TAG=latest
