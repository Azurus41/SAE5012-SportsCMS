# Valeurs par défaut (versionnées). Les vraies valeurs vont dans .env.local (non versionné) :
#   APP_ENV=prod, APP_SECRET=<32 caractères aléatoires>, DATABASE_URL=<base MySQL/MariaDB>
APP_ENV=dev
APP_SECRET=change-me-in-env-local

# MySQL du docker-compose ; sur alwaysdata : mysql://UTILISATEUR:MOT_DE_PASSE@mysql-azurus.alwaysdata.net:3306/azurus_touchline?serverVersion=...&charset=utf8mb4
DATABASE_URL="mysql://touchline:change-moi@db:3306/touchline?serverVersion=8.4&charset=utf8mb4"

# Dossier où sont écrits les fichiers déposés (CSV, images) et URL publique correspondante.
UPLOAD_DIR=%kernel.project_dir%/public/uploads
UPLOAD_URL=/uploads
